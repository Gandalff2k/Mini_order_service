# Copy to .env only if you want to override the defaults baked into docker-compose.yml.
# `docker compose up` works without this file.

APP_ENV=local
APP_LOG_LEVEL=INFO

POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders

DB_HOST=postgres
DB_PORT=5432
DB_USER=orders
DB_PASSWORD=orders
DB_NAME=orders
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_DLQ_TOPIC=orders.events.dlq
KAFKA_CONSUMER_GROUP_ID=notifications
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000

OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=0.2
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=1.0
OUTBOX_BACKOFF_CAP_SECONDS=30.0
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10.0

CONSUMER_MAX_ATTEMPTS=5
CONSUMER_BACKOFF_BASE_SECONDS=1.0
CONSUMER_BACKOFF_CAP_SECONDS=30.0
